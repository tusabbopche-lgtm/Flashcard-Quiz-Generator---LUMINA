# Copy this file to `.env` and adjust it.
#
# LLM_PROVIDER:
#   offline             - use the built-in rule-based engine (default, no network)
#   openai_compatible   - call an OpenAI-compatible chat-completions endpoint
#
# LLM_BASE_URL may point at a local server (Ollama, LM Studio, vLLM, llama.cpp)
# or at a hosted API. A missing "/v1" suffix is added automatically.
LLM_PROVIDER=offline
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=llama3.1

# Optional: fix the random seed used by the offline engine for reproducible output.
APP_SEED=
